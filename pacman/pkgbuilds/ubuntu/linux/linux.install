post_install() {
  # ${1}: new package version
  boot/update-kernel.sh
}

post_upgrade() {
  # ${1}: new package version
  # ${2}: old package version
  [ $(vercmp "${1%-*}" "${2%-*}") -ne 0 ] || return 0
  rm -vf "boot/initrd.img-${2%-*}-KZL"
  [ -f etc/machine-id ] && rm -vrf "boot/efi/$(cat etc/machine-id)/${2%-*}-KZL"
  rm -vrf "lib/modules/${2%-*}-KZL"
  post_install
}

post_remove() {
  # ${1}: old package version
  rm -vf "boot/initrd.img-${1%-*}-KZL" "boot/efi/initrd-KZL.img"
}
